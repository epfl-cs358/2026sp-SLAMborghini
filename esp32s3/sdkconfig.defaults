# SLAMborghini ESP32-S3 — ESP-IDF Kconfig overrides
# Applied by PlatformIO before building (merged into sdkconfig).
# Do not delete: wifi_dashboard.c needs WebSocket support compiled in.

# WebSocket support in the ESP-IDF HTTP server (required for /ws endpoint)
CONFIG_HTTPD_WS_SUPPORT=y

# Wi-Fi station mode (STA) — the firmware connects to your router
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Increase HTTP server task stack (WebSocket frames can be large)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Main task stack — WiFi init + SLAM locals need more than the 8 KB default
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
