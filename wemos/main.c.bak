/**
 * wemos/main.c
 *
 * Wemos D1 R32 — motion controller + odometry sender.
 *
 * Two-board architecture:
 *   ESP32-S3 (SLAM brain) ──UART──► Wemos D1 R32 (motion controller)
 *
 * Two-task architecture:
 *   task_odometry     priority 5, 100 Hz  — AS5600 + ICM-20948 fusion,
 *                                           publishes odom_pose_t
 *   task_pure_pursuit priority 4,  20 Hz  — receives path_frame_t from
 *                                           ESP32-S3, runs PP controller,
 *                                           drives servo + motor, sends
 *                                           odom_t back to ESP32-S3
 *
 * Coordinate-frame note:
 *   The ESP32-S3 generates paths in its own world frame (origin ≈ map centre,
 *   typically 5000 mm, 5000 mm).  The Wemos odometry starts at (0, 0).
 *   On path receipt, waypoints are rigidly transformed so that wp[0] aligns
 *   with the current Wemos odometry pose.  This assumes both boards start
 *   with the same heading (theta = 0) from the shared IMU.
 */

#include "hardware_pins.h"
#include "imu_gyro.h"
#include "src/uart_bridge.h"
#include "src/pure_pursuit_controller.h"
#include "src/task_odometry.h"
#include "src/imu_encoder_driver.h"
#include "src/encoder_ackermann_odometry.h"

#include "driver/ledc.h"
#include "driver/uart.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "esp_log.h"
#include "esp_timer.h"

#include <math.h>
#include <string.h>

static const char *TAG = "wemos_main";

/* ── Motor config ─────────────────────────────────────────────────────────── */
#define MOTOR_PWM_FREQ_HZ   1000
#define MOTOR_PWM_RES       LEDC_TIMER_8_BIT
#define MOTOR_DUTY_FWD      25
#define CH_FWD              LEDC_CHANNEL_3
#define CH_BWD              LEDC_CHANNEL_2

/* ── Servo config ─────────────────────────────────────────────────────────── */
#define SERVO_PWM_FREQ_HZ   50
#define SERVO_PWM_RES       LEDC_TIMER_16_BIT
#define SERVO_CH            LEDC_CHANNEL_0
#define SERVO_DUTY_CENTER   4987u
#define SERVO_DUTY_LEFT     4442u
#define SERVO_DUTY_RIGHT    5533u
#define SERVO_STEER_GAIN    1042.0f

/* ── PP loop rate ─────────────────────────────────────────────────────────── */
#define PP_PERIOD_MS        50u   /* 20 Hz */

/* ════════════════════════════════════════════════════════════════════════════
 * Actuator helpers
 * ════════════════════════════════════════════════════════════════════════════ */

static void motor_set(float speed_mm_s)
{
    uint32_t duty = (speed_mm_s > 0.0f) ? (uint32_t)MOTOR_DUTY_FWD : 0u;
    ledc_set_duty(LEDC_LOW_SPEED_MODE, CH_FWD, duty);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, CH_FWD);
    ledc_set_duty(LEDC_LOW_SPEED_MODE, CH_BWD, 0u);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, CH_BWD);
}

static void servo_set_deg(float steering_deg)
{
    float rad = (steering_deg - 90.0f) * ((float)M_PI / 180.0f);
    int32_t duty = (int32_t)SERVO_DUTY_CENTER + (int32_t)(rad * SERVO_STEER_GAIN);
    if (duty < (int32_t)SERVO_DUTY_LEFT)  duty = (int32_t)SERVO_DUTY_LEFT;
    if (duty > (int32_t)SERVO_DUTY_RIGHT) duty = (int32_t)SERVO_DUTY_RIGHT;
    ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_CH, (uint32_t)duty);
    ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_CH);
}

static float wrap_rad(float a)
{
    a = fmodf(a, 2.0f * (float)M_PI);
    if (a >  (float)M_PI) a -= 2.0f * (float)M_PI;
    if (a < -(float)M_PI) a += 2.0f * (float)M_PI;
    return a;
}

/* ════════════════════════════════════════════════════════════════════════════
 * task_pure_pursuit  —  priority 4, 20 Hz
 *
 * Each iteration:
 *   1. Pull any pending path_frame_t from UART bridge; translate it into the
 *      Wemos local odometry frame and load it into the PP controller.
 *   2. Copy the current fused pose from task_odometry.
 *   3. Run pp_compute_command() to get steering + speed.
 *   4. Actuate servo and motor; or signal path_done and stop.
 *   5. Build and send odom_t (linear_disp + yaw_rate + dt) to ESP32-S3.
 * ════════════════════════════════════════════════════════════════════════════ */
static void task_pure_pursuit(void *pvParameters)
{
    (void)pvParameters;

    pure_pursuit_controller_t pp;
    pp_init(&pp);

    float    prev_dist_m  = imu_encoder_driver_get_distance_m();
    float    prev_heading = imu_encoder_driver_get_yaw_rad();
    int64_t  prev_us      = esp_timer_get_time();
    uint32_t odom_seq     = 0;
    bool     path_active  = false;

    for (;;) {
        /* ── Real dt ────────────────────────────────────────────────────── */
        int64_t now_us = esp_timer_get_time();
        float dt_s = (float)(now_us - prev_us) * 1e-6f;
        if (dt_s < 0.005f) dt_s = 0.005f;
        if (dt_s > 0.200f) dt_s = 0.200f;
        prev_us = now_us;

        /* ── 1. Accept path from ESP32-S3 ──────────────────────────────── */
        path_frame_t pf;
        if (uart_bridge_recv_path(&pf)) {
            uart_bridge_send_path_ack(pf.length);

            if (pf.length > 0) {
                /* Rigidly transform waypoints from S3-world to Wemos-local.
                 *
                 * wp[0] is where the S3 thinks the robot is when it generated
                 * the path.  The actual Wemos odometry pose is (wx, wy, wth).
                 * Compute the SE(2) transform T from S3-origin to Wemos-pose
                 * and apply it to every waypoint:
                 *   rx = wp[i].x - base_x           (S3-relative)
                 *   ry = wp[i].y - base_y
                 *   local.x = wx + c*rx - s*ry       (rotated + translated)
                 *   local.y = wy + s*rx + c*ry
                 * where c = cos(wth - base_th), s = sin(wth - base_th).      */
                odom_pose_t op;
                task_odometry_copy_pose(&op);
                float wx   = op.x * 1000.0f;   /* m → mm */
                float wy   = op.y * 1000.0f;
                float wth  = op.theta;

                float base_x  = pf.waypoints[0].x;
                float base_y  = pf.waypoints[0].y;
                float base_th = pf.waypoints[0].theta;
                float dth     = wrap_rad(wth - base_th);
                float c       = cosf(dth);
                float sv      = sinf(dth);

                for (uint8_t i = 0; i < pf.length; i++) {
                    float rx = pf.waypoints[i].x - base_x;
                    float ry = pf.waypoints[i].y - base_y;
                    pf.waypoints[i].x     = wx + (c * rx - sv * ry);
                    pf.waypoints[i].y     = wy + (sv * rx + c * ry);
                    pf.waypoints[i].theta = wrap_rad(pf.waypoints[i].theta - base_th + wth);
                }

                pp_set_path(&pp, pf.waypoints, pf.length);
                path_active = true;
                ESP_LOGI(TAG, "path: %u wps  local start=(%.0f mm, %.0f mm)",
                         (unsigned)pf.length,
                         (double)pf.waypoints[0].x, (double)pf.waypoints[0].y);
            } else {
                /* Empty path = cancel current path */
                pp_set_path(&pp, NULL, 0);
                path_active = false;
            }
        }

        /* ── 2. Current fused pose (odom_pose_t is in metres → convert mm) */
        odom_pose_t op;
        task_odometry_copy_pose(&op);
        pose_t pose = {
            .x     = op.x * 1000.0f,
            .y     = op.y * 1000.0f,
            .theta = op.theta,
        };

        /* ── 3. PP command ──────────────────────────────────────────────── */
        pp_motion_command_t cmd = pp_compute_command(&pp, &pose);

        /* ── 4. Actuate ─────────────────────────────────────────────────── */
        if (path_active && cmd.stop) {
            motor_set(0.0f);
            servo_set_deg(90.0f);
            task_odometry_set_steering_rad(0.0f);
            uart_bridge_send_path_done();
            path_active = false;
            ESP_LOGI(TAG, "path complete  pose=(%.0f mm, %.0f mm, %.1f°)",
                     (double)pose.x, (double)pose.y,
                     (double)(pose.theta * 180.0f / (float)M_PI));
        } else if (path_active) {
            float steer_rad = (cmd.steering_deg - 90.0f) * ((float)M_PI / 180.0f);
            servo_set_deg(cmd.steering_deg);
            motor_set(cmd.speed_mm_s);
            task_odometry_set_steering_rad(steer_rad);
        } else {
            /* Idle — hold centre and stop */
            motor_set(0.0f);
            servo_set_deg(90.0f);
            task_odometry_set_steering_rad(0.0f);
        }

        /* ── 5. Send odom_t to ESP32-S3 ────────────────────────────────── */
        float cur_dist    = imu_encoder_driver_get_distance_m();
        float cur_heading = imu_encoder_driver_get_yaw_rad();

        float disp_mm  = (cur_dist - prev_dist_m) * 1000.0f;
        float dheading = wrap_rad(cur_heading - prev_heading);

        prev_dist_m  = cur_dist;
        prev_heading = cur_heading;

        odom_t pkt = {
            .linear_disp_mm = disp_mm,
            .yaw_rate_imu   = dheading / dt_s,
            .dt_ms          = dt_s * 1000.0f,
            .seq            = odom_seq++,
        };
        uart_bridge_send_odom(&pkt);

        ESP_LOGD(TAG,
                 "odom: disp=%.2f mm  rate=%.3f r/s  dt=%.1f ms"
                 "  steer=%.1f°  active=%d",
                 (double)pkt.linear_disp_mm, (double)pkt.yaw_rate_imu,
                 (double)pkt.dt_ms, (double)cmd.steering_deg,
                 (int)path_active);

        vTaskDelay(pdMS_TO_TICKS(PP_PERIOD_MS));
    }
}

/* ════════════════════════════════════════════════════════════════════════════
 * Hardware init
 * ════════════════════════════════════════════════════════════════════════════ */

static void motor_ledc_init(void)
{
    ledc_timer_config_t tmr = {
        .speed_mode      = LEDC_LOW_SPEED_MODE,
        .duty_resolution = MOTOR_PWM_RES,
        .timer_num       = LEDC_TIMER_1,
        .freq_hz         = MOTOR_PWM_FREQ_HZ,
        .clk_cfg         = LEDC_AUTO_CLK,
    };
    ledc_timer_config(&tmr);

    ledc_channel_config_t fwd = {
        .gpio_num   = MOTOR_F_PIN,
        .speed_mode = LEDC_LOW_SPEED_MODE,
        .channel    = CH_FWD,
        .timer_sel  = LEDC_TIMER_1,
        .duty       = 0,
        .hpoint     = 0,
    };
    ledc_channel_config(&fwd);

    ledc_channel_config_t bwd = {
        .gpio_num   = MOTOR_B_PIN,
        .speed_mode = LEDC_LOW_SPEED_MODE,
        .channel    = CH_BWD,
        .timer_sel  = LEDC_TIMER_1,
        .duty       = 0,
        .hpoint     = 0,
    };
    ledc_channel_config(&bwd);
}

static void servo_ledc_init(void)
{
    ledc_timer_config_t tmr = {
        .speed_mode      = LEDC_LOW_SPEED_MODE,
        .duty_resolution = SERVO_PWM_RES,
        .timer_num       = LEDC_TIMER_0,
        .freq_hz         = SERVO_PWM_FREQ_HZ,
        .clk_cfg         = LEDC_AUTO_CLK,
    };
    ledc_timer_config(&tmr);

    ledc_channel_config_t ch = {
        .gpio_num   = SERVO_PIN,
        .speed_mode = LEDC_LOW_SPEED_MODE,
        .channel    = SERVO_CH,
        .timer_sel  = LEDC_TIMER_0,
        .duty       = SERVO_DUTY_CENTER,
        .hpoint     = 0,
    };
    ledc_channel_config(&ch);
}

/* ════════════════════════════════════════════════════════════════════════════
 * app_main
 * ════════════════════════════════════════════════════════════════════════════ */
void app_main(void)
{
    /* UART bridge first so the RX FIFO is allocated before calibration */
    uart_bridge_init();

    /* I2C + ICM-20948 init — required before any gyro or encoder read */
    if (!imu_gyro_init()) {
        ESP_LOGE(TAG, "IMU init failed — check I2C wiring SDA=%d SCL=%d",
                 WEMOS_I2C_SDA, WEMOS_I2C_SCL);
        for (;;) vTaskDelay(pdMS_TO_TICKS(1000));
    }

    /* Gyro bias calibration — robot must be stationary for ~3 s */
    float bias = imu_gyro_calibrate_bias(300);
    ESP_LOGI(TAG, "gyro bias = %.5f rad/s", (double)bias);

    motor_ledc_init();
    servo_ledc_init();
    servo_set_deg(90.0f);   /* centre servo before tasks start */

    xTaskCreate(task_odometry,     "odom", 4096, NULL, 5, NULL);
    xTaskCreate(task_pure_pursuit, "pp",   4096, NULL, 4, NULL);
}
